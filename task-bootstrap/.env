# ============================================
# TASK MANAGER API - ENVIRONMENT VARIABLES
# ============================================

# ------------------------------
# SERVER CONFIGURATION
# ------------------------------
SERVER_PORT=8080
CONTEXT_PATH=/api

# ------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------
DB_URL=jdbc:postgresql://localhost:5432/taskdb_mod
DB_USER=postgres
DB_PASSWORD=frank

# ------------------------------
# DATABASE CONFIGURATION (Alternative avec Docker)
# ------------------------------
# DB_URL=jdbc:postgresql://postgres:5432/taskdb
# DB_USER=taskuser
# DB_PASSWORD=taskpass

# ------------------------------
# JWT SECURITY CONFIGURATION
# ------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ------------------------------
# EMAIL CONFIGURATION (SMTP)
# ------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@taskmanager.com

# ------------------------------
# REDIS CONFIGURATION (Cache)
# ------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------
# APPLICATION CONFIGURATION
# ------------------------------
APP_NAME=Task Manager API
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000

# ------------------------------
# LOGGING CONFIGURATION
# ------------------------------
LOG_LEVEL=DEBUG
LOG_FILE=logs/task-manager.log

# ------------------------------
# SPRING PROFILES
# ------------------------------
SPRING_PROFILES_ACTIVE=dev

# ------------------------------
# CORS CONFIGURATION
# ------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200